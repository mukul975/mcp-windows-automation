{
  "mcpServers": {
    "unified-server": {
      "command": "python",
      "args": [
        "Path to\\mcpwindows\\unified_server.py"
      ],
      "env": {
        "MYSQL_USER": "MYSQL_USER",
        "MYSQL_PASSWORD": "MYSQL_PASSWORD",
        "MYSQL_DATABASE": "MYSQL_DATABASE_NAME",  
        "MYSQL_PORT": "3306",
        "MYSQL_HOST": "localhost"
      }
    }
  }
}